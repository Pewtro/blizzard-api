{
  "name": "@blizzard-api/client",
  "version": "5.4.0",
  "description": "A node.js client to integrate with the blizzard battle.net api.",
  "keywords": [
    "api",
    "battle.net",
    "battlenet",
    "blizzard",
    "bnet",
    "classic",
    "d3",
    "diablo",
    "hearthstone",
    "hs",
    "retail",
    "sc2",
    "starcraft",
    "warcraft",
    "world of warcraft",
    "wow"
  ],
  "license": "MIT",
  "author": "Putro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pewtro/blizzard-api.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "@blizzard-api/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "pnpm test -- --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "ky": "2.1.0"
  },
  "devDependencies": {
    "@blizzard-api/classic-wow": "workspace:*",
    "@blizzard-api/core": "workspace:*",
    "@blizzard-api/d3": "workspace:*",
    "@blizzard-api/hs": "workspace:*",
    "@blizzard-api/sc2": "workspace:*",
    "@blizzard-api/wow": "workspace:*"
  },
  "peerDependencies": {
    "@blizzard-api/core": "4.1.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  }
}
