{
  "name": "@blizzard-api/root",
  "version": "1.0.0",
  "description": "A series of helpers to interact with the Blizzard Battle.net API",
  "keywords": [
    "api",
    "battle.net",
    "battlenet",
    "blizzard",
    "bnet",
    "classic",
    "d3",
    "diablo",
    "hearthstone",
    "hs",
    "retail",
    "sc2",
    "starcraft",
    "warcraft",
    "world of warcraft",
    "wow"
  ],
  "license": "MIT",
  "author": "Putro",
  "repository": "https://github.com/Pewtro/blizzard-api",
  "type": "module",
  "scripts": {
    "build:docs": "typedoc",
    "build": "turbo build",
    "generate:zod": "tsx ./scripts/generate-zod.ts",
    "generate": "npm-run-all -l generate:zod \"lint:fix ./generated\" \"oxfmt:write ./generated\"",
    "lint:ci": "npm-run-all -p -l typecheck oxfmt:check \"lint .\"",
    "lint:fix": "pnpm lint --fix",
    "lint": "eslint --format stylish --max-warnings 0",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "oxfmt:check": "oxfmt --check",
    "oxfmt:write": "oxfmt",
    "test:coverage": "pnpm run test --coverage",
    "test:ui": "vitest --ui --coverage",
    "test:watch": "vitest watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@putstack/eslint-config-typescript": "5.5.1",
    "@putstack/oxfmt-config": "0.2.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.6",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.73.0",
    "publint": "0.3.25",
    "ts-to-zod": "5.1.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.11.2"
}
